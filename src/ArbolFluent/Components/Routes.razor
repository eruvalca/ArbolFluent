<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(ArbolFluent.UI.UiAssemblyMarker).Assembly }" NotFoundPage="typeof(ArbolFluent.UI.Features.Errors.Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(ArbolFluent.UI.Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
