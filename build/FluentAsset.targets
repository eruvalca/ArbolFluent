<Project>
  <!-- The application serves a generated copy; the installed NuGet package is never edited. -->
  <Target Name="PatchFluentThemeCache"
          AfterTargets="ResolveCoreStaticWebAssets"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_FluentRoot>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)fluent/'))</_FluentRoot>
      <_FluentPatched>$(_FluentRoot)Microsoft.FluentUI.AspNetCore.Components.lib.module.js</_FluentPatched>
    </PropertyGroup>
    <ItemGroup>
      <_FluentOriginal Include="@(StaticWebAsset)"
                          Condition="'%(StaticWebAsset.SourceId)' == 'Microsoft.FluentUI.AspNetCore.Components' and '%(StaticWebAsset.AssetTraitValue)' == 'JSLibraryModule'" />
    </ItemGroup>
    <Error Condition="'@(_FluentOriginal->Count())' != '1'" Text="Expected exactly one Fluent initializer module to apply the pinned lifetime fix." />
    <Exec Command="&quot;$(_ArbolFluentDotNetHost)&quot; &quot;@(_ArbolFluentBuildAssembly)&quot; patch-fluent &quot;@(_FluentOriginal)&quot; &quot;$(_FluentPatched)&quot;" />
    <ItemGroup>
      <_FluentCandidate Include="@(_FluentOriginal->'$(_FluentPatched)')">
        <ContentRoot>$(_FluentRoot)</ContentRoot>
        <OriginalItemSpec>$(_FluentPatched)</OriginalItemSpec>
        <Fingerprint />
        <Integrity />
        <FileLength />
        <LastWriteTime />
      </_FluentCandidate>
      <StaticWebAsset Remove="@(_FluentOriginal)" />
      <StaticWebAssetEndpoint Remove="@(StaticWebAssetEndpoint)" Condition="'%(StaticWebAssetEndpoint.AssetFile)' == '@(_FluentOriginal)'" />
      <FileWrites Include="$(_FluentPatched)" />
    </ItemGroup>
    <DefineStaticWebAssets CandidateAssets="@(_FluentCandidate)">
      <Output TaskParameter="Assets" ItemName="_FluentAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints CandidateAssets="@(_FluentAsset)" ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
    <ItemGroup>
      <StaticWebAsset Include="@(_FluentAsset)" />
    </ItemGroup>
  </Target>
</Project>
