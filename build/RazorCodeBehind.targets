<Project>
  <PropertyGroup>
    <_ArbolFluentBuildProject>$(MSBuildThisFileDirectory)ArbolFluent.Build/ArbolFluent.Build.csproj</_ArbolFluentBuildProject>
    <_ArbolFluentDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</_ArbolFluentDotNetHost>
    <_ArbolFluentDotNetHost Condition="'$(_ArbolFluentDotNetHost)' == ''">dotnet</_ArbolFluentDotNetHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(_ArbolFluentBuildProject)"
                      ReferenceOutputAssembly="false"
                      OutputItemType="_ArbolFluentBuildAssembly"
                      Private="false"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
  </ItemGroup>

  <!-- Always recheck, including incremental builds and deleted companion files. -->
  <Target Name="ValidateRazorCodeBehind"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences;ResolveRazorComponentInputs"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_ArbolFluentComponentManifest>$(IntermediateOutputPath)arbolfluent-razor-components.txt</_ArbolFluentComponentManifest>
      <_ArbolFluentCompileManifest>$(IntermediateOutputPath)arbolfluent-compile-files.txt</_ArbolFluentCompileManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(_ArbolFluentComponentManifest)" Lines="@(RazorComponent->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_ArbolFluentCompileManifest)" Lines="@(Compile->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <FileWrites Include="$(_ArbolFluentComponentManifest);$(_ArbolFluentCompileManifest)" />
    </ItemGroup>
    <!-- A separate process avoids locking the validator's assemblies in reusable MSBuild nodes. -->
    <Exec Command="&quot;$(_ArbolFluentDotNetHost)&quot; &quot;@(_ArbolFluentBuildAssembly)&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(RootNamespace)&quot; &quot;$(DefineConstants)&quot; &quot;$(_ArbolFluentComponentManifest)&quot; &quot;$(_ArbolFluentCompileManifest)&quot;"
          Condition="'@(RazorComponent)' != ''" />
  </Target>
</Project>
